{:paths ["src"]
 :min-bb-version "1.3.0"
 :bbin/bin {suisho {:main-opts ["-m" "suisho.main"]}}
 :tasks
 {:requires ([clojure.test :as t])
  :init (defn run-test-nses [nses]
          (doseq [n nses] (require n))
          (let [{:keys [fail error]} (apply t/run-tests nses)]
            (when (pos? (+ fail error))
              (System/exit 1))))
  test {:doc "Run unit tests"
        :extra-paths ["test"]
        :task (run-test-nses '[suisho.parse-test
                               suisho.convert-test
                               suisho.spec-test
                               suisho.main-test])}
  golden {:doc "Run the golden output regression test"
          :extra-paths ["test"]
          :task (run-test-nses '[suisho.golden-test])}
  convert {:doc "Convert a Cosense export JSON to Quartz Markdown"
           :requires ([suisho.main])
           :task (apply suisho.main/-main *command-line-args*)}
  update-golden {:doc "Regenerate test/golden/expected from the fixture"
                 :requires ([suisho.main])
                 :task (suisho.main/-main "test/golden/export.json"
                                          "-o" "test/golden/expected")}}}
